# ─── AWS RDS PostgreSQL ─────────────────────────────────────────────────────
# Option A: Use DATABASE_URL (preferred)
DATABASE_URL=postgresql://username:password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/looplic
DATABASE_SSL=true

# Option B: Individual RDS variables
RDS_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=looplic
RDS_USER=looplic_user
RDS_PASSWORD=your-password
RDS_SSL=true

# ─── Supabase (Authentication only — DB stays on RDS) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only; used for admin user lookups. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_APP_URL=https://www.looplic.com

# ─── AWS IAM (for S3 presigned uploads / RDS access) ─────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AWS S3 (File/Image Storage) ─────────────────────────────────────────────
NEXT_PUBLIC_S3_BUCKET=looplic-assets
NEXT_PUBLIC_S3_REGION=ap-south-1
S3_UPLOAD_ROLE_ARN=arn:aws:iam::041149335823:role/looplic-s3-upload

# ─── Email (Resend — unchanged) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_LEADS_TO=touheed@looplic.com
RESEND_FROM_EMAIL=Looplic <touheed@looplic.com>
RESEND_REPLY_TO=touheed@looplic.com

# ─── Cache (Upstash Redis — unchanged) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# Optional. When set, all page views + gtag events (booking/sell/contact/etc.)
# are also sent to this GA4 property. Leave empty to keep Ads-only tracking.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ─── WhatsApp Bot (Meta Cloud API) ───────────────────────────────────────────
# All server-only. The bot lives in the user app: webhook at /api/whatsapp/webhook.
# Get these from Meta Business Manager → WhatsApp → API Setup.
# The bot can answer on MULTIPLE numbers under the same Meta app (e.g.
# 8884445924 and 9886579923) with no extra env vars — the webhook reads which
# number a message arrived on straight from Meta's payload and replies from
# that same number (see src/lib/whatsapp/phone-context.ts). The one below is
# only the FALLBACK used for outbound sends that don't originate from an
# inbound WhatsApp message (e.g. the website's booking-confirmation ping).
# Phone number ID of the default WhatsApp Business number (NOT the display phone number).
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User access token (temporary tokens expire in 24h).
WHATSAPP_ACCESS_TOKEN=
# Any random string you invent; paste the SAME value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta App → Settings → Basic) — used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Optional: Graph API version. Defaults to v21.0.
WHATSAPP_API_VERSION=v21.0
# Optional: comma-separated staff numbers (E.164, no +) that get internal
# new-lead alerts on WhatsApp, e.g. 918884445924. Falls back to no alert if empty.
WHATSAPP_TEAM_NUMBERS=
# Optional: name of the approved template used for booking confirmations sent
# outside the 24h customer-service window. Leave empty to skip templated sends.
WHATSAPP_BOOKING_TEMPLATE=
# Optional: public URL of a branded logo/banner (jpeg or png ONLY, must be a
# solid/colored image — NOT the white transparent email logo) used as the header
# of the booking-confirmation message. Defaults to /looplic-app-icon-512.png.
WHATSAPP_LOGO_URL=

# ─── Anthropic (Claude) — powers the WhatsApp conversational bot ──────────────
# Server-only. When empty, the bot still works with the rule-based menu but the
# AI free-text fallback is disabled.
ANTHROPIC_API_KEY=
