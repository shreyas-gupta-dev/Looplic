# ─── AWS RDS PostgreSQL ─────────────────────────────────────────────────────
# Option A: Use DATABASE_URL (preferred)
DATABASE_URL=postgresql://username:password@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/looplic
DATABASE_SSL=true

# Option B: Individual RDS variables
RDS_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=looplic
RDS_USER=looplic_user
RDS_PASSWORD=your-password
RDS_SSL=true

# ─── Supabase (Authentication only — DB stays on RDS) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only; used for admin user lookups. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_AWS_REGION=ap-south-1
NEXT_PUBLIC_APP_URL=https://www.looplic.com

# ─── AWS IAM (for S3 presigned uploads / RDS access) ─────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── AWS S3 (File/Image Storage) ─────────────────────────────────────────────
NEXT_PUBLIC_S3_BUCKET=looplic-assets
NEXT_PUBLIC_S3_REGION=ap-south-1
S3_UPLOAD_ROLE_ARN=arn:aws:iam::041149335823:role/looplic-s3-upload

# ─── Email (Resend — unchanged) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_LEADS_TO=touheed@looplic.com
RESEND_FROM_EMAIL=Looplic <touheed@looplic.com>
RESEND_REPLY_TO=touheed@looplic.com

# ─── Cache (Upstash Redis — unchanged) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Maps ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
# Optional. When set, all page views + gtag events (booking/sell/contact/etc.)
# are also sent to this GA4 property. Leave empty to keep Ads-only tracking.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
