{
  "name": "looplic-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:user": "npm run dev -w @looplic/user",
    "dev:admin": "npm run dev -w @looplic/admin",
    "dev:technician": "npm run dev -w @looplic/technician",
    "build:user": "npm run build -w @looplic/user",
    "build:admin": "npm run build -w @looplic/admin",
    "build:technician": "npm run build -w @looplic/technician",
    "db:push": "drizzle-kit push --config=packages/db/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "typescript": "^5.8.3"
  }
}
